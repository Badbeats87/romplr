+void CXHCIDevice::PollEvents (void)
+{
+	// Identical to InterruptHandler but called from main loop
+	// Must only be used after DisableInterrupts() to avoid races
+
+	// Acknowledge any pending interrupt status
+	u32 nStatus = m_pMMIO->op_read32 (XHCI_REG_OP_USBSTS);
+	if (nStatus & XHCI_REG_OP_USBSTS_EINT)
+	{
+		m_pMMIO->op_write32 (XHCI_REG_OP_USBSTS, nStatus | XHCI_REG_OP_USBSTS_EINT);
+		m_pMMIO->rt_write32 (0, XHCI_REG_RT_IR_IMAN,
+			m_pMMIO->rt_read32 (0, XHCI_REG_RT_IR_IMAN) | XHCI_REG_RT_IR_IMAN_IP);
+	}
+
+	if (nStatus & XHCI_REG_OP_USBSTS_HCH)
+	{
+		return;
+	}
+
+	TXHCITRB *pEventTRB = 0;
+	TXHCITRB *pNextEventTRB;
+	assert (m_pEventManager != 0);
+
+	unsigned nTries = XHCI_CONFIG_MAX_EVENTS_PER_INTR;
+	while (   nTries-- != 0
+	       && (pNextEventTRB = m_pEventManager->HandleEvents ()) != 0)
+	{
+		pEventTRB = pNextEventTRB;
 	}
+
+	if (pEventTRB != 0)
+	{
+		m_pMMIO->rt_write64 (0, XHCI_REG_RT_IR_ERDP_LO,   XHCI_TO_DMA (pEventTRB)
+							| XHCI_REG_RT_IR_ERDP_LO_EHB);
+	}
 	else
 	{
 		m_pMMIO->rt_write64 (0, XHCI_REG_RT_IR_ERDP_LO,
@@ -422,6 +466,22 @@
 	}
 }
 
+void CXHCIDevice::DisableXHCIInterrupts (void)
+{
+	// Clear INTE bit — stop xHCI from generating PCIe interrupts
+	m_pMMIO->op_write32 (XHCI_REG_OP_USBCMD,
+		m_pMMIO->op_read32 (XHCI_REG_OP_USBCMD) & ~XHCI_REG_OP_USBCMD_INTE);
+
+	// Disconnect IRQ handler
+	if (m_bInterruptConnected)
+	{
+		m_pInterruptSystem->DisconnectIRQ (ARM_IRQ_XHCI);
+		m_bInterruptConnected = FALSE;
+	}
+
+	CLogger::Get ()->Write ("xhci", LogNotice, "Interrupts disabled, polling mode");
+}
