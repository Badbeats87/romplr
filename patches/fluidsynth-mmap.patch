 /* Private functions */
+
+#if defined(HAVE_SYS_MMAN_H)
+static fluid_samplecache_entry_t *new_samplecache_entry_mmap(SFData *sf,
+        unsigned int sample_start,
+        unsigned int sample_end,
+        int sample_type,
+        time_t mtime)
+{
+    fluid_samplecache_entry_t *entry;
+    int fd;
+    off_t file_offset;
+    off_t page_offset;
+    size_t page_size;
+    size_t data_length;
+    size_t map_length;
+    void *map_base;
+    unsigned int num_samples;
+
+    /* Only handle 16-bit samples (not 24-bit) for simplicity */
+    if(sf->sample24pos != 0 || sf->sample24size != 0)
+    {
+        return NULL;
+    }
+
+    /* Open our own fd since SFData may close its handle */
+    fd = open(sf->fname, O_RDONLY);
+    if(fd < 0)
+    {
+        return NULL;
+    }
+
+    num_samples = sample_end + 1 - sample_start;
+    /* file_offset is in bytes: samplepos is chunk start, sample_start is in samples (16-bit) */
+    file_offset = (off_t)sf->samplepos + (off_t)sample_start * 2;
+    data_length = (size_t)num_samples * 2;
+
+    /* Align to page boundary */
+    page_size = (size_t)sysconf(_SC_PAGESIZE);
+    page_offset = file_offset & ~(off_t)(page_size - 1);
+    map_length = data_length + (size_t)(file_offset - page_offset);
+
+    map_base = mmap(NULL, map_length, PROT_READ, MAP_PRIVATE, fd, page_offset);
+    if(map_base == MAP_FAILED)
+    {
+        close(fd);
+        return NULL;
+    }
+
+    /* Advise kernel to start readahead */
+    madvise(map_base, map_length, MADV_WILLNEED);
+
+    entry = FLUID_NEW(fluid_samplecache_entry_t);
+    if(entry == NULL)
+    {
+        munmap(map_base, map_length);
+        close(fd);
+        return NULL;
+    }
+
+    FLUID_MEMSET(entry, 0, sizeof(*entry));
+
+    entry->filename = FLUID_STRDUP(sf->fname);
+    if(entry->filename == NULL)
+    {
+        munmap(map_base, map_length);
+        close(fd);
+        FLUID_FREE(entry);
+        return NULL;
+    }
+
+    entry->sf_samplepos = sf->samplepos;
+    entry->sf_samplesize = sf->samplesize;
+    entry->sf_sample24pos = sf->sample24pos;
+    entry->sf_sample24size = sf->sample24size;
+    entry->sample_start = sample_start;
+    entry->sample_end = sample_end;
+    entry->sample_type = sample_type;
+    entry->modification_time = mtime;
+
+    entry->sample_data = (short *)((char *)map_base + (file_offset - page_offset));
+    entry->sample_data24 = NULL;
+    entry->sample_count = (int)num_samples;
+
+    entry->mmapped = TRUE;
+    entry->mmap_base = map_base;
+    entry->mmap_length = map_length;
+    entry->mmap_fd = fd;
+
+    FLUID_LOG(FLUID_DBG, "mmap'd sample cache: %s offset=%ld len=%zu", sf->fname, (long)file_offset, data_length);
+
+    return entry;
+}
+#endif
+
 static fluid_samplecache_entry_t *new_samplecache_entry(SFData *sf,
         unsigned int sample_start,
         unsigned int sample_end,
